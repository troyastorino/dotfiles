#!/bin/sh
# Runs Claude Code on the personal Claude account.
#
# Each Claude account has its own config directory, so a login in one account
# never moves the sessions of another. The team account keeps the default
# directory (~/.claude), where the scheduled jobs run.
#
# First use: claude-personal auth login --email <personal address>
CLAUDE_CONFIG_DIR="$HOME/.claude-personal" exec claude "$@"
