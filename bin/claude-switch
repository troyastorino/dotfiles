#!/usr/bin/env bash
# Moves the Claude Code conversation in a tmux pane to another Claude account.
#
# Use it when one account reaches its usage limit. It stops the session in the
# pane and starts the same conversation, in the same pane and directory, on the
# account you name. The accounts share one transcript folder
# (claude/link-account-dirs.sh), so the conversation needs no copy.
#
# Inside a session, type:   ! claude-switch research
# From another pane, type:  claude-switch research %12
#
# A slash command can't do this at a usage limit, because a custom command
# needs a model turn. The `!` prefix runs a shell command with no model turn.
#
# A busy session loses the turn it is in, so the switch refuses a busy session
# unless you pass --now. Artifacts and claude.ai connectors belong to the first
# account and don't follow the conversation.
#
# Usage: claude-switch [--now] <team|personal|research> [pane]
#   pane defaults to the pane this command runs in.

set -euo pipefail

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

now=0
detached=0
args=()
for arg in "$@"; do
  case "$arg" in
    -h | --help)
      usage
      exit 0
      ;;
    --now) now=1 ;;
    --detached) detached=1 ;;
    *) args+=("$arg") ;;
  esac
done

# The second half of a switch. It runs in its own session (setsid), because
# stopping Claude also stops the processes Claude started, this script included
# when you run it with `!`.
if [ "$detached" -eq 1 ]; then
  pane="${args[0]}" pid="${args[1]}" command="${args[2]}" cwd="${args[3]}"
  # Keep the pane when its process exits, so there is a pane to restart.
  tmux set-option -p -t "$pane" remain-on-exit on
  kill -TERM "$pid" 2>/dev/null || true
  waited=0
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 10 ]; do
    sleep 1
    waited=$((waited + 1))
  done
  tmux respawn-pane -k -t "$pane" -c "$cwd" "$command"
  tmux set-option -p -u -t "$pane" remain-on-exit
  exit 0
fi

account="${args[0]:-}"
pane="${args[1]:-${TMUX_PANE:-}}"
case "$account" in
  team | personal | research) ;;
  *)
    usage >&2
    exit 2
    ;;
esac
if [ -z "$pane" ]; then
  echo "Run this inside tmux, or name a pane (for example %12)." >&2
  exit 1
fi
launcher="$(command -v "claude-$account" || true)"
if [ -z "$launcher" ]; then
  echo "claude-$account isn't on the PATH." >&2
  exit 1
fi

# Each running session keeps a registry file that names its tmux pane.
address="$(tmux display-message -p -t "$pane" '#{session_name}:#{window_id}.#{pane_id}')"
found="$(
  python3 -I - "$address" <<'PY'
import glob, json, os, sys

address = sys.argv[1]
home = os.path.expanduser("~")
accounts = {".claude": "team", ".claude-personal": "personal", ".claude-research": "research"}
best = None
for directory, account in accounts.items():
    for path in glob.glob(os.path.join(home, directory, "sessions", "*.json")):
        try:
            record = json.load(open(path))
        except (OSError, ValueError):
            continue
        if record.get("tmux") != address or not record.get("sessionId"):
            continue
        if not os.path.exists(f"/proc/{record.get('pid')}"):
            continue
        if best is None or record.get("updatedAt", 0) > best[0].get("updatedAt", 0):
            best = (record, account)
if best:
    record, account = best
    print(record["pid"], record["sessionId"], record.get("status") or "unknown", account, record["cwd"])
PY
)"
if [ -z "$found" ]; then
  echo "No running Claude Code session found in pane $pane." >&2
  exit 1
fi
read -r pid session status current cwd <<<"$found"

if [ "$current" = "$account" ]; then
  echo "Pane $pane already runs on the $account account."
  exit 0
fi
# A session that runs this command through `!` reports itself as busy for as
# long as the command runs. That session is an ancestor of this process, and
# the person typed the switch into it, so the busy check doesn't apply.
inside=0
ancestor=$$
while [ "$ancestor" -gt 1 ]; do
  if [ "$ancestor" = "$pid" ]; then
    inside=1
    break
  fi
  ancestor="$(ps -o ppid= -p "$ancestor" 2>/dev/null | tr -d ' ')"
  [ -n "$ancestor" ] || break
done
if [ "$status" = busy ] && [ "$now" -eq 0 ] && [ "$inside" -eq 0 ]; then
  echo "The session in pane $pane is busy. Wait for it, or pass --now and lose the turn it is in." >&2
  exit 1
fi

# A pane whose first process is a shell gets its shell back after Claude exits.
command="$launcher --resume $session"
root="$(ps -o comm= -p "$(tmux display-message -p -t "$pane" '#{pane_pid}')" 2>/dev/null || true)"
case "$root" in
  zsh | bash | sh | fish | -zsh | -bash) command="$command; exec ${SHELL:-/bin/sh} -l" ;;
esac

setsid "$0" --detached "$pane" "$pid" "$command" "$cwd" </dev/null >/dev/null 2>&1 &
echo "Moving the conversation in pane $pane from $current to $account."
