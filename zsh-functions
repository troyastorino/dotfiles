# Zsh functions, sourced from zshrc.

# Serve an HTML file's directory with python http.server and open it in the
# browser on your Mac. Companion to bin/openhtml — use servehtml when the page
# has relative assets (CSS/JS/images next to the file); openhtml pushes only
# the single file's bytes.
#
# Usage: servehtml [-p PORT] <file.html>
#   -p PORT   serve on PORT instead of 23180. Each port is its own server
#             (pid/dir/log under /tmp/servehtml-PORT.*), so pass a different
#             port to keep several directories served at once. SERVEHTML_PORT
#             changes the default.
#
# Requires the Mac-side setup in macos/openhtml/README.md:
#   - LocalForward 23180-23189 so the Mac browser can reach the servers. The
#     range sits in an unassigned IANA block; keep it in sync with
#     SERVEHTML_FIRST_PORT/SERVEHTML_LAST_PORT in macos/openhtml/install.sh.
#   - the openhtml-listener + RemoteForward 7777, used here to auto-open the
#     URL (via a meta-refresh redirect page). Without it, the URL is printed
#     for you to open manually.
servehtml() {
  emulate -L zsh
  local first_port=23180 last_port=23189
  local listener_port="${OPENHTML_PORT:-7777}"

  local -a opt_port
  if ! zparseopts -D -E -F -- p:=opt_port; then
    echo "usage: servehtml [-p PORT] <file.html>" >&2
    return 1
  fi
  local port="${opt_port[-1]:-${SERVEHTML_PORT:-$first_port}}"
  local file="$1"

  if [[ -z "$file" ]]; then
    echo "usage: servehtml [-p PORT] <file.html>" >&2
    return 1
  fi
  if [[ "$port" != <1-65535> ]]; then
    echo "servehtml: port must be a number from 1 to 65535, got: $port" >&2
    return 1
  fi
  if [[ ! -f "$file" ]]; then
    echo "servehtml: no such file: $file" >&2
    return 1
  fi

  local dir="${file:A:h}" name="${file:A:t}"
  local pidfile="/tmp/servehtml-$port.pid"
  local dirfile="/tmp/servehtml-$port.dir"
  local logfile="/tmp/servehtml-$port.log"

  # Reuse the running server if it's alive, listening, and serving this
  # directory; otherwise (re)start it.
  local pid="" saved_dir=""
  [[ -f "$pidfile" ]] && pid="$(<"$pidfile")"
  [[ -f "$dirfile" ]] && saved_dir="$(<"$dirfile")"
  if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null \
      || [[ "$saved_dir" != "$dir" ]] || ! nc -z 127.0.0.1 "$port" 2>/dev/null; then
    [[ -n "$pid" ]] && kill "$pid" 2>/dev/null
    python3 -m http.server "$port" --bind 127.0.0.1 --directory "$dir" >"$logfile" 2>&1 &!
    pid=$!
    print -r -- "$pid" >"$pidfile"
    print -r -- "$dir" >"$dirfile"
    local i
    for i in {1..20}; do
      nc -z 127.0.0.1 "$port" 2>/dev/null && break
      if ! kill -0 "$pid" 2>/dev/null; then
        echo "servehtml: server failed to start on port $port (see $logfile)" >&2
        return 1
      fi
      sleep 0.1
    done
  fi

  local url="http://localhost:$port/$(python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))' "$name")"
  # Auto-open on the Mac by sending a redirect page to the openhtml listener.
  if print -r -- "<meta http-equiv=\"refresh\" content=\"0;url=$url\">" \
      | nc -N -w 5 127.0.0.1 "$listener_port" 2>/dev/null; then
    echo "serving $dir on port $port — opened $url on your Mac"
  else
    echo "serving $dir on port $port"
    echo "couldn't reach the Mac listener on port $listener_port — open $url in your Mac browser"
  fi
  if (( port < first_port || port > last_port )); then
    echo "note: port $port is outside the Mac tunnel range $first_port-$last_port; the URL won't resolve on your Mac without your own LocalForward" >&2
  fi
}

# Keep the Mac side of the Coder bridges (macos/*) installed and current.
# zshrc calls this from every interactive shell on the Mac. Each bridge needs
# three things on the Mac: the listener linked into ~/.local/bin, a
# RemoteForward in ~/.ssh/config, and a loaded LaunchAgent. Any of them can
# go missing on a fresh machine, and a listener keeps running old code after
# `git pull` until it is restarted. The installer fixes all of that and is
# idempotent, so run it when a check fails or when a file in the bridge's
# directory is newer than the stamp the installer leaves. Silent otherwise.
dotfiles-mac-check() {
  emulate -L zsh
  setopt extended_glob
  [[ "$OSTYPE" == darwin* ]] || return 0
  local root="${DOTFILES_DIR:-$HOME/dotfiles}"
  # This runs on every shell start, so avoid forks: read the SSH config with
  # $(<file), which zsh does in-process, and call launchctl once for all
  # bridges. That one call is most of the cost (about 15 ms).
  local sshcfg="" jobs=""
  [[ -f "$HOME/.ssh/config" ]] && sshcfg="$(<"$HOME/.ssh/config")"
  jobs="$(launchctl list 2>/dev/null)"
  local tool dir stamp reason f
  for tool in clipboard openhtml; do
    dir="$root/macos/$tool"
    [[ -x "$dir/install.sh" ]] || continue
    stamp="$HOME/.cache/$tool/installed"
    reason=""
    if [[ ! -e "$HOME/.local/bin/$tool-listener" ]]; then
      reason="~/.local/bin/$tool-listener is missing"
    elif [[ "$sshcfg" != *"macos/$tool/install.sh"* ]]; then
      reason="the SSH forward is not in ~/.ssh/config"
    elif [[ "$jobs" != *"com.user.$tool-listener"* ]]; then
      reason="the LaunchAgent is not loaded"
    elif [[ ! -f "$stamp" ]]; then
      reason="no record of an install"
    else
      for f in "$dir"/*(N.); do
        if [[ "$f" -nt "$stamp" ]]; then
          reason="${f:t} changed since the last install"
          break
        fi
      done
    fi
    [[ -n "$reason" ]] || continue
    echo "dotfiles: $tool bridge: $reason. Running $dir/install.sh"
    if ! "$dir/install.sh"; then
      echo "dotfiles: $tool install failed. See $dir/README.md" >&2
    fi
  done
}

# Keep ~/.claude/skills in step with ~/picnic/skills on the Mac. zshrc calls
# this from every interactive shell. The linked set changes when a skill is
# added or removed, which bumps the mtime of ~/picnic/skills, or when a
# SKILL.md changes, which can move a skill in or out of the Coder set. A
# `git pull` or branch switch in ~/picnic does either. So compare those
# against the stamp claude/link-picnic-skills.sh leaves, in-process (about
# 4 ms), and relink only when one is newer. The script prints only changes.
dotfiles-picnic-skills-check() {
  emulate -L zsh
  [[ "$OSTYPE" == darwin* ]] || return 0
  local src="$HOME/picnic/skills" stamp="$HOME/.cache/picnic-skills/linked"
  local root="${DOTFILES_DIR:-$HOME/dotfiles}"
  [[ -d "$src" && -x "$root/claude/link-picnic-skills.sh" ]] || return 0
  if [[ -f "$stamp" && ! "$src" -nt "$stamp" ]]; then
    local -a newer=( "$src"/*/SKILL.md(NY1e:'[[ $REPLY -nt $stamp ]]':) )
    (( $#newer )) || return 0
  fi
  "$root/claude/link-picnic-skills.sh" -q
}

# ssh that reconnects when the connection drops, for the Mac's connection to
# the Coder workspace. The workspace's zshrc attaches tmux at login, so a
# reconnect lands back in the same tmux session, and the clipboard and
# openhtml forwards come back with it.
#
# Usage: sshr <host> [ssh args...]
#
# ssh exits 255 when the connection fails or drops, as after the laptop
# sleeps ("Connection to ... closed by remote host"). Then sshr waits and
# connects again, waiting longer after each failure, up to 30s. Ctrl+C during
# the wait stops it. Any other status comes from the remote shell, which means
# you logged out, so sshr returns it. ServerAlive makes ssh give up on a dead
# connection after about 30s instead of hanging.
sshr() {
  emulate -L zsh
  if (( $# == 0 )); then
    echo "usage: sshr <host> [ssh args...]" >&2
    return 2
  fi
  local rc start delay=1
  while true; do
    start=$SECONDS
    command ssh -o ServerAliveInterval=10 -o ServerAliveCountMax=3 "$@"
    rc=$?
    (( rc == 255 )) || return $rc
    _sshr_reset_terminal
    # A session that ran a while was a good connection, so start over at 1s.
    (( SECONDS - start > 60 )) && delay=1
    echo "sshr: connection lost. Reconnecting in ${delay}s. Ctrl+C stops." >&2
    sleep $delay
    (( delay = delay * 2 > 30 ? 30 : delay * 2 ))
  done
}

# A dropped connection leaves the terminal in the modes tmux turned on. With
# mouse reporting still on, moving the mouse prints escape codes at the local
# prompt. tmux turns these off when it detaches cleanly (tty_stop_tty in tmux's
# tty.c), so send the same sequences: scroll region, colors, keypad, cursor
# shape and visibility, mouse reporting, bracketed paste, focus events,
# extended keys and margins, then leave the alternate screen.
_sshr_reset_terminal() {
  printf '\e[r\e[m\e[?1l\e>\e[0 q\e[?12l\e[?25h'
  printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?1005l'
  printf '\e[?2004l\e[?1004l\e[>4m\e[?69l\e[?1049l'
}
